  "parser": "def parser(input: str, output: str) -> tuple[int, int, int, int]:\n    \"\"\"\n    Parses the problem input and output into (x, hh, mm, y).\n    \"\"\"\n    s = input.strip()\n    if not s:\n        raise ValueError('Empty input')\n    lines = [line.strip() for line in s.splitlines() if line.strip() != '']\n    first = lines[0].split()\n    x = int(first[0])\n    if len(lines) >= 2:\n        parts = lines[1].split()\n    else:\n        parts = first[1:]\n    if len(parts) < 2:\n        raise ValueError('Could not parse hh and mm')\n    hh = int(parts[0])\n    mm = int(parts[1])\n    out_tokens = output.strip().split()\n    if not out_tokens:\n        raise ValueError('Empty output')\n    y = int(out_tokens[0])\n    return (x, hh, mm, y)",
