#!/usr/bin/env bash
# Build the pinned Dafny fork and its Z3 solvers under one build-directory lock.
# Builds are skipped when the existing binary already reports the pinned commit.
set -euo pipefail

root=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
build_dir=${BUILD_DIR:-_build}
mkdir -p "$build_dir"
build_dir=$(cd "$build_dir" && pwd)
exec 9>"$build_dir/.dafny.lock"
flock 9

read_pin() {
    python3 -c 'import sys, tomllib; print(tomllib.load(open(sys.argv[1], "rb"))[sys.argv[2]])' \
        dafny-version.toml "$1"
}
repo=$(read_pin repo)
commit=$(read_pin commit)
if [[ ! $commit =~ ^[0-9a-f]{40}$ ]]; then
    echo "dafny-version.toml: commit must be 40 lowercase hex digits" >&2
    exit 2
fi

src="$build_dir/dafny"
dafny_bin="$src/Binaries/Dafny"
z3_bin="$src/Binaries/z3/bin"

built_version() {
    [[ -x $dafny_bin && -x $z3_bin/z3-4.16.0 && -x $z3_bin/z3-4.12.1 ]] || return 1
    local version
    version=$("$dafny_bin" --version)
    [[ $version == *"+$commit"* ]] || return 1
    printf '%s\n' "$version"
}

if version=$(built_version); then
    echo "Dafny $version is ready at $dafny_bin"
    exit 0
fi

if [[ $(uname -s):$(uname -m) != Linux:x86_64 ]]; then
    echo "The pinned Z3 snapshot supports x86_64 Linux only, not $(uname -s) $(uname -m)" >&2
    exit 2
fi

mkdir -p "$src"
[[ -d $src/.git ]] || git -C "$src" init --quiet
if [[ -n $(git -C "$src" status --porcelain) ]]; then
    echo "$src has local modifications; refusing to build" >&2
    exit 2
fi
if [[ $(git -C "$src" rev-parse -q --verify HEAD || true) != "$commit" ]]; then
    git -C "$src" fetch --depth 1 "$repo" "$commit"
    git -C "$src" checkout --detach FETCH_HEAD
fi

scratch=$(mktemp -d "$build_dir/dafny-build-XXXXXX")
trap 'rm -rf "$scratch"' EXIT
if [[ ! -x $z3_bin/z3-4.16.0 || ! -x $z3_bin/z3-4.12.1 ]]; then
    # The fork's Makefile downloads into the current directory and moves the solvers
    # into Binaries/z3/bin, so run it from a scratch directory.
    (cd "$scratch" && make -f "$src/Makefile" z3-ubuntu)
fi

# Build servers outlive the build and would keep the lock open: MSBuild nodes idle for
# about 15 minutes, so the next run would wait on flock. Disable node reuse and the shared
# compiler, and keep the lock descriptor away from the build (9>&-).
dotnet build "$src/Source/Dafny.sln" --no-incremental -nodeReuse:false \
    -p:UseSharedCompilation=false \
    -p:PathMap="$src=/src/dafny" \
    -p:ContinuousIntegrationBuild=true \
    -p:Deterministic=true 9>&-

if ! version=$(built_version); then
    echo "built Dafny does not report +$commit" >&2
    exit 2
fi
echo "Dafny $version is ready at $dafny_bin"
